# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública do site — usada pra montar o link de recuperação de senha
# que vai por e-mail (sem isso, o link do e-mail aponta pra localhost).
NEXT_PUBLIC_SITE_URL=https://seu-dominio-na-vercel.vercel.app

# Necessária a partir da Fase F (Portal do Cliente) — usada apenas em
# Server Actions administrativas (lib/supabase/admin.ts), NUNCA no navegador.
# Fica em Project Settings > API > service_role (NÃO é a chave anon).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Central de Comunicação (Fase 9) — Meta WhatsApp Cloud API.
# Todas opcionais: sem elas, o webhook ainda recebe e grava mensagens
# normalmente, só o ENVIO automático fica desligado (ver whatsapp.api.ts).
WHATSAPP_VERIFY_TOKEN=defina-um-token-qualquer-para-o-handshake-da-meta
WHATSAPP_APP_SECRET=app-secret-do-app-da-meta-para-validar-assinatura-do-webhook
WHATSAPP_ACCESS_TOKEN=token-de-acesso-permanente-da-cloud-api
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-de-telefone-no-business-manager
# Só quando true o envio de mensagem de fato chama a API da Meta:
WHATSAPP_INTEGRACAO_ATIVA=false

# WhatsApp Web (QR Code) — Fase 22. Só necessário se você ativar esse
# provider na tela Configurações → Integrações → WhatsApp.
# WHATSAPP_WEB_BRIDGE_URL: endereço do serviço Bridge (Railway, Fly.io,
# VPS...). WHATSAPP_WEB_BRIDGE_SECRET: mesmo valor precisa estar
# configurado no Bridge também — é o que autentica a comunicação entre
# os dois lados.
WHATSAPP_WEB_BRIDGE_URL=https://seu-bridge.up.railway.app
WHATSAPP_WEB_BRIDGE_SECRET=defina-um-segredo-longo-e-aleatorio-aqui

# IA (Fase 26) — só necessário configurar a chave do provedor que você
# for de fato usar (escolhido em Configurações → IA). A chave nunca fica
# no banco nem no navegador — vive só aqui.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cron do follow-up de recuperação de venda (Fase 32) — protege a rota
# /api/cron/follow-up-vendas contra chamada externa. A Vercel manda esse
# valor automaticamente no header quando CRON_SECRET está configurada
# nas variáveis de ambiente do projeto (não precisa fazer nada além de
# definir o mesmo valor aqui e lá). Também protege /api/prostec/scraper/cron.
CRON_SECRET=defina-um-segredo-longo-e-aleatorio-aqui

# Prostec — scraper próprio do Google Maps (substitui a Google Places
# API). Veja infra/prostec-scraper/README.md pro passo a passo de
# deploy no Railway. PROSTEC_SCRAPER_URL é o domínio do serviço
# "gateway" (Caddy), nunca o do scraper em si (que não tem domínio
# público). PROSTEC_SCRAPER_API_KEY precisa ser o mesmo valor de
# SCRAPER_API_KEY configurado no gateway.
PROSTEC_SCRAPER_URL=http://localhost:8080
PROSTEC_SCRAPER_API_KEY=
PROSTEC_SCRAPER_DEFAULT_DEPTH=5
PROSTEC_SCRAPER_MAX_TIME=600
# Deixe vazio — só usar se algum dia o volume de buscas exigir proxies
# pra não tomar bloqueio de IP do Google (ver README da infra).
PROSTEC_SCRAPER_PROXIES=

# Banco Central de Imagens — importação em lote (Fase 247). Protege as
# rotas /api/banco-imagens/lote/* contra chamada externa — DIFERENTE do
# CRON_SECRET acima: sem essa env definida, a rota responde 503 e NÃO
# roda (fail-closed), nunca libera sem segredo por falta de configuração.
# Só necessário se você for usar a importação em lote do catálogo
# externo de fotos.
BANCO_IMAGENS_IMPORT_TOKEN=
# loja_id explícito pra essas rotas (elas rodam com createAdminClient,
# sem sessão de usuário pra descobrir a loja sozinha). Se vazio, usa a
# única loja cadastrada (instalação single-tenant).
BANCO_IMAGENS_LOJA_ID=

# NEO Performance (Fase 259+) — Meta Ads. Sem essas 3, a tela de
# Configurações do NEO Performance mostra a conta como "sem credenciais"
# e a sincronização não roda (nunca finge dado — ver ads.service.ts).
# META_ADS_ACCESS_TOKEN: token de sistema (System User) do Business
# Manager, com permissão ads_read no mínimo. META_ADS_APP_SECRET: do
# app usado pra gerar o token. META_ADS_AD_ACCOUNT_ID: no formato
# act_XXXXXXXXX (Configurações da conta de anúncios).
META_ADS_ACCESS_TOKEN=
META_ADS_APP_SECRET=
META_ADS_AD_ACCOUNT_ID=

# NEO Performance — Google Ads. O schema (ads_contas/ads_campanhas/
# ads_metricas_diarias) já suporta Google desde a Fase 1, mas a
# sincronização real só é implementada quando estas existirem.
# GOOGLE_ADS_DEVELOPER_TOKEN: do Google Ads API Center (nível MCC).
# GOOGLE_ADS_CLIENT_ID / SECRET / REFRESH_TOKEN: de um OAuth client
# configurado no Google Cloud Console com acesso à Google Ads API.
# GOOGLE_ADS_CUSTOMER_ID: ID da conta (sem hífen), ex: 1234567890.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# NEO Performance — geração de imagem de criativos (Creative Factory,
# Fase 2). DIFERENTE do GEMINI_API_KEY de cima (esse é usado só pra
# texto, pela Central de Cotações/IA). Geração de IMAGEM usa a API do
# Gemini pra imagem (Imagen), que pode exigir uma chave/projeto Google
# Cloud separado — confirme no AI Studio/Vertex qual chave habilita
# geração de imagem antes de preencher. Sem isso, o Creative Factory
# nunca inventa uma imagem falsa — só avisa que não está configurado.
GEMINI_IMAGE_API_KEY=
